# ═══════════════════════════════════════════════════════
#  Finance Vault — .gitignore
#  WICHTIG: Niemals persönliche Finanzdaten committen!
# ═══════════════════════════════════════════════════════

# ── Persönliche Daten (NIEMALS teilen!) ─────────────────
data/finance.db
data/finance.db-wal
data/finance.db-shm
data/*.db
data/*.db-*
data/documents/
!data/.gitkeep
!data/documents/.gitkeep

# Hochgeladene Belege & Bilder
app/static/uploads/*
!app/static/uploads/.gitkeep

# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python

# Virtual Environments
venv/
env/
.venv/
.env/
ENV/
env.bak/
venv.bak/

# ── Build / Distribution ─────────────────────────────────
build/
dist/
*.egg-info/
*.egg
*.spec
!vault_finance.spec
MANIFEST

# PyInstaller Output
dist/
build/
*.exe
!release/*.exe

# ── Umgebungsvariablen (Secrets!) ────────────────────────
.env
.env.local
.env.production
.env.*
!.env.example

# ── IDE & Editor ─────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────────
*.log
logs/
flask.log

# ── Test & Coverage ──────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Sonstiges ────────────────────────────────────────────
*.bak
*.tmp
*.temp
instance/
.webassets-cache
